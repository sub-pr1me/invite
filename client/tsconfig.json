{
"compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
},
"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/components/Customer.tsx", "src/components/ArchivedDate.tsx", "src/components/EditGallery.tsx", "src/components/UserProfile.tsx", "src/pages/Explore.tsx", "src/components/Log_In.tsx"]
}